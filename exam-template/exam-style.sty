% ============================================================
% exam-template/exam-style.sty — 通用模拟试卷样式（全科共用）
%
% 用法：在科目目录下建一个同名文件，内容为
%   \NeedsTeXFormat{LaTeX2e}
%   \ProvidesPackage{exam-style}[...]
%   \RequirePackage{../exam-template/exam-style}
% 然后试卷/答案 tex 只写 \usepackage{exam-style}，
% 编译时从仓库根目录执行 xelatex（保证相对路径可用）。
%
% 依赖：仓库根的 notestyle.sty / codestyle.sty
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{exam-style}[2026/10/05 Universal Mock Exam Style]

% notestyle.sty 位于仓库根目录。xelatex 从仓库根目录编译时，
% 本文件位于 ./exam-template/，故相对路径为 ../notestyle.sty。
% 注：新版 TeX Live 会忽略 \input@path 中以 .. 开头的条目，
% 因此这里显式探测若干候选深度，保证从仓库根目录编译可用。
\makeatletter
\def\input@path{{./}{../}{../../}{../../../}}
\@for\ds:=./,../,../../,../../../\do{%
  \IfFileExists{\ds notestyle.sty}{\xdef\notespath{\ds}}{}%
}
\makeatother

\RequirePackage{\notespath notestyle}

\RequirePackage{lastpage}
\RequirePackage{graphicx}
\RequirePackage{longtable}
\RequirePackage{multirow}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{underscore}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, positioning}

% ============================================================
% 试卷版式（A4，正文 11pt）
% ============================================================
\geometry{
  a4paper,
  top=2.0cm, bottom=2.0cm,
  left=2.0cm, right=2.0cm,
  headheight=22pt, headsep=0.45cm,
  footskip=0.7cm,
}

\fancyhf{}
\fancyfoot[C]{\fontsize{9pt}{10pt}\selectfont\color{ctp-subtext0}第 \thepage 页 \quad 共 \pageref{LastPage} 页}
\renewcommand{\headrulewidth}{0.5pt}
\renewcommand{\footrulewidth}{0.3pt}

\setcounter{secnumdepth}{3}
\titleformat{\section}{\centering\large\bfseries\color{ctp-mauve}}{\thesection}{1em}{}
\titleformat{\subsection}{\normalsize\bfseries\color{ctp-blue}}{\thesubsection}{1em}{}
\titlespacing*{\section}{0pt}{0.8em}{0.4em}
\titlespacing*{\subsection}{0pt}{0.5em}{0.25em}

% ============================================================
% 封面：\examcover{科目名}{卷号}{考试内容}{分值}{时长}{注意事项}
% 参数字符串为空时自动省略对应行。
% ============================================================
\newcommand{\examcover}[6]{%
  \thispagestyle{empty}%
  \begin{center}
    \vspace*{1.0cm}
    {\fontsize{19pt}{26pt}\selectfont\bfseries\color{ctp-text} #1}\\[0.28cm]
    {\fontsize{13.5pt}{18pt}\selectfont\bfseries\color{ctp-mauve} #2}\\[0.6cm]
    \rule{\textwidth}{1.2pt}\\[0.45cm]
    {\normalsize
      \begin{tabular}{rl}
        \ifx\relax#3\relax\else\textbf{考试内容：} & #3 \\[2pt]\fi
        \textbf{满分：} & #4 \\[2pt]
        \textbf{建议用时：} & #5 \\
      \end{tabular}
    }
    \vspace{0.45cm}

    \colorbox{ctp-surface0}{\parbox{0.92\textwidth}{
      \vspace{0.12cm}
      {\small\textbf{考生须知：}}
      \begin{enumerate}[leftmargin=1.8em, itemsep=1pt, topsep=3pt, font=\small]
        \item #6
        \item 答案一律写在答题纸上，写在试卷上无效。
        \item 考试结束后，将本试卷和答题纸一并交回。
      \end{enumerate}
      \vspace{0.08cm}
    }}
    \vspace{0.3cm}
  \end{center}
  % 注意：不再重置页码，使「第 x 页 共 N 页」中的 N（LastPage）与 PDF 实际页数一致
  \newpage
}

% 兼容旧写法
\newcommand{\examtitle}{}

% ============================================================
% 答案封面
% ============================================================
\newcommand{\answercover}[2]{%
  \thispagestyle{empty}%
  \begin{center}
    \vspace*{1.2cm}
    {\fontsize{19pt}{26pt}\selectfont\bfseries\color{ctp-text} #1}\\[0.3cm]
    {\fontsize{13.5pt}{18pt}\selectfont\bfseries\color{ctp-mauve} #2}\\[0.7cm]
    \rule{\textwidth}{1.2pt}
  \end{center}
  \vspace{0.6cm}
}

% ============================================================
% 结构命令
% ============================================================
% 大板块标题（第一部分 / A 卷 …）
\newcommand{\parttitle}[1]{%
  \vspace{0.45em}
  \begin{center}
    \colorbox{ctp-mauve}{\color{white}\fontsize{13pt}{18pt}\selectfont\bfseries\space #1 \space}
  \end{center}
  \vspace{0.3em}
}

% 题型名称行：\qtypename{一、单项选择题}{40 分，每题 2 分}
\newcommand{\qtypename}[2]{%
  \vspace{0.35em}
  \noindent{\bfseries\large\color{ctp-text}【#1】}\quad
  {\small\color{ctp-subtext0}（#2）}\par
  \vspace{0.1em}
}

% 填空题下划线
\newcommand{\fillblank}{\underline{\hspace{2.6cm}}}
% 较短的下划线（用于括号内填空）
\newcommand{\fillblanks}[1][2.0cm]{\underline{\hspace{#1}}}

% 简答/论述题留白：\anslines{2cm}
% 用 \par\vspace* 而不是裸 \vspace：位于题首/段首时裸 \vspace 会被吞掉
\newcommand{\anslines}[1]{\par\vspace*{#1}\par\noindent\ignorespaces}

% 已废弃的得分框（保留兼容）
\newcommand{\scorebox}{}

% ============================================================
% 题号计数器
% ============================================================
\newcounter{question}
\newcommand{\q}{\stepcounter{question}\noindent\textbf{\arabic{question}.}\space\ignorespaces}
\newcounter{progq}
\newcommand{\pq}{\stepcounter{progq}\noindent\textbf{\arabic{progq}.}\space\ignorespaces}
% 每题独立计数的组题环境：\begin{qgroup} ... \end{qgroup} 内题号重置
\newenvironment{qgroup}{\setcounter{question}{0}}{}

% 选择题选项：\choices{A 选项}{B 选项}{C 选项}{D 选项}
\newcommand{\choices}[4]{%
  \par\vspace{0.15em}
  \noindent\hspace{1.4em}%
  \begin{tabularx}{\dimexpr\textwidth-1.4em\relax}{@{}X@{\hspace{1em}}X@{}}
    #1 & #2 \\[1pt] #3 & #4
  \end{tabularx}\par
}

% 单行选项（4 项紧凑排布）
\newcommand{\choicesline}[4]{%
  \par\vspace{0.1em}\noindent\hspace{1.4em}%
  \makebox[0.23\textwidth][l]{#1}\makebox[0.23\textwidth][l]{#2}%
  \makebox[0.23\textwidth][l]{#3}\makebox[0.23\textwidth][l]{#4}\par
}

% 答案区小标题
\newcommand{\answerpart}[1]{%
  \vspace{0.4em}
  \noindent{\bfseries\large\color{ctp-mauve} #1}\par
  \vspace{0.15em}
}

% 解析环境
\newenvironment{analysis}{%
  \par\vspace{0.2em}\noindent{\small\color{ctp-subtext0}\bfseries 解析：}\small\color{ctp-subtext1}%
}{\par\vspace{0.3em}}

% 页面书眉：\examinehead{左}{右}
\newcommand{\examinehead}[2]{%
  \fancyhead[L]{\fontsize{9pt}{10pt}\selectfont\color{ctp-subtext0} #1}%
  \fancyhead[R]{\fontsize{9pt}{10pt}\selectfont\color{ctp-subtext0} #2}%
}

\endinput
